---
const {
  title = 'TechPilot AI — Practical AI & Tech Guides',
  description = 'Clear, practical guides to AI tools, software, and everyday technology.',
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/ai-tools/', label: 'AI Tools' },
  { href: '/how-to/', label: 'How-To Guides' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="TechPilot AI home">
          <span class="brand-mark">T<span>P</span></span>
          <span class="brand-name">TechPilot <b>AI</b></span>
        </a>
        <nav aria-label="Main navigation">
          {navItems.map((item) => (
            <a class:list={[{ active: path === item.href || (item.href !== '/' && path.startsWith(item.href)) }]} href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="header-cta" href="/ai-tools/">Explore tools <span aria-hidden="true">↗</span></a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-top">
          <a class="brand" href="/">
            <span class="brand-mark">T<span>P</span></span>
            <span class="brand-name">TechPilot <b>AI</b></span>
          </a>
          <p>Make technology work for you.</p>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} TechPilot AI. All rights reserved.</span>
          <div class="footer-links">
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/disclaimer/">Disclaimer</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eef2ff;background:#0b1020;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--muted:#a1abc4;--line:rgba(180,195,235,.15);--panel:#111a30;--mint:#80f0c0;--blue:#8ba8ff}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;min-width:320px;background:radial-gradient(ellipse at 50% -20%,rgba(65,90,170,.24),transparent 55%),#0b1020}
  a{color:inherit;text-decoration:none}
  .site-shell{max-width:1240px;margin:0 auto;padding:0 34px}
  .site-header{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}
  .brand{display:inline-flex;align-items:center;gap:10px;white-space:nowrap}
  .brand-mark{display:grid;place-items:center;width:37px;height:37px;border-radius:12px;background:linear-gradient(135deg,#80f0c0,#8ba8ff);color:#0b1020;font-weight:900;font-size:13px;letter-spacing:-1px}
  .brand-mark span{margin-left:1px}
  .brand-name{font-weight:750;letter-spacing:-.5px;font-size:18px}.brand-name b{color:var(--mint)}
  nav{display:flex;align-items:center;gap:27px}
  nav a{font-size:13px;color:#b8c1d8;transition:color .2s}nav a:hover,nav a.active{color:var(--mint)}
  .header-cta{font-size:13px;font-weight:700;padding:11px 15px;border:1px solid rgba(128,240,192,.45);border-radius:10px;color:var(--mint);white-space:nowrap}
  .header-cta span{margin-left:8px}
  .site-footer{margin-top:90px;padding:30px 0 25px;border-top:1px solid var(--line)}
  .footer-top,.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px}
  .footer-top p{color:var(--muted);font-size:13px}
  .footer-bottom{border-top:1px solid var(--line);margin-top:24px;padding-top:20px;color:#8390ad;font-size:12px}
  .footer-links{display:flex;gap:20px;flex-wrap:wrap}.footer-links a:hover{color:var(--mint)}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--mint);font-size:11px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}
  .eyebrow:before{content:"";display:inline-block;width:22px;height:1px;background:var(--mint)}
  .page-hero{padding:76px 0 42px;max-width:790px}
  .page-hero h1{font-size:clamp(36px,6vw,62px);line-height:1.04;letter-spacing:-2.8px;margin:18px 0}
  .page-hero p{font-size:17px;line-height:1.8;color:var(--muted);max-width:650px}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:52px 0 22px}
  .section-heading h2{margin:0;font-size:25px;letter-spacing:-.8px}.section-heading p{margin:7px 0 0;color:var(--muted);font-size:14px}
  .text-link{color:var(--mint);font-size:13px;font-weight:700;white-space:nowrap}
  .card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
  .content-card{display:flex;flex-direction:column;min-height:220px;padding:23px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,rgba(24,36,63,.92),rgba(15,23,42,.82));transition:transform .2s,border-color .2s}
  .content-card:hover{transform:translateY(-3px);border-color:rgba(128,240,192,.42)}
  .card-icon{display:grid;place-items:center;width:43px;height:43px;border-radius:13px;background:rgba(128,240,192,.1);font-size:20px;margin-bottom:24px}
  .card-tag{color:var(--mint);font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}
  .content-card h3{font-size:18px;line-height:1.4;letter-spacing:-.4px;margin:10px 0}
  .content-card p{font-size:13px;line-height:1.75;color:var(--muted);margin:0 0 20px}
  .card-arrow{margin-top:auto;color:var(--mint);font-size:13px;font-weight:700}
  .feature-band{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center;margin-top:64px;padding:34px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(120deg,rgba(29,43,76,.9),rgba(15,23,42,.6))}
  .feature-band h2{font-size:clamp(25px,3vw,37px);line-height:1.15;letter-spacing:-1.4px;margin:12px 0}
  .feature-band p{color:var(--muted);line-height:1.8;font-size:14px}
  .feature-stat{padding:22px;border:1px solid var(--line);border-radius:16px;background:rgba(7,12,25,.35)}
  .feature-stat strong{display:block;font-size:25px;color:var(--mint);margin-bottom:7px}.feature-stat span{color:var(--muted);font-size:12px;line-height:1.6}
  .prose{max-width:800px;padding-bottom:20px}.prose h2{margin-top:34px;font-size:23px}.prose p,.prose li{color:#b8c1d8;font-size:15px;line-height:1.9}.prose a{color:var(--mint);text-decoration:underline;text-underline-offset:3px}
  .notice{padding:18px 20px;border:1px solid rgba(128,240,192,.24);background:rgba(128,240,192,.06);border-radius:13px;color:#c9d5e9;font-size:13px;line-height:1.8}
  .contact-box{padding:25px;border:1px solid var(--line);border-radius:16px;background:var(--panel);max-width:600px}
  .contact-box p{color:var(--muted);line-height:1.8}
  @media(max-width:900px){.site-shell{padding:0 22px}.site-header{flex-wrap:wrap;padding:18px 0}.site-header nav{order:3;width:100%;justify-content:space-between;gap:12px}.header-cta{margin-left:auto}.card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.site-shell{padding:0 17px}.site-header{gap:12px}.brand-name{font-size:16px}.header-cta{padding:9px 10px;font-size:12px}nav a{font-size:12px}.page-hero{padding:54px 0 30px}.page-hero h1{letter-spacing:-1.7px}.page-hero p{font-size:15px}.card-grid{grid-template-columns:1fr}.content-card{min-height:190px}.feature-band{grid-template-columns:1fr;padding:23px}.section-heading{align-items:start;flex-direction:column}.footer-top,.footer-bottom{align-items:flex-start;flex-direction:column}.footer-bottom{font-size:11px}.footer-links{gap:15px}}
</style>
